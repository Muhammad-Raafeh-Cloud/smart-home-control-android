<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Individual Tags -->

    <TextView
        android:id="@+id/tag_lights"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lights"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <TextView
        android:id="@+id/tag_ac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AC"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <TextView
        android:id="@+id/tag_security"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Security"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <TextView
        android:id="@+id/tag_thermostat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thermostat"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <TextView
        android:id="@+id/tag_cameras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cameras"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <TextView
        android:id="@+id/tag_sensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensors"
        android:padding="8dp"
        android:background="@drawable/bg_card"/>

    <!-- Flow Helper -->

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/tag_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tag_lights,tag_ac,tag_security,tag_thermostat,tag_cameras,tag_sensors"
        app:flow_wrapMode="chain"
        app:flow_horizontalGap="8dp"
        app:flow_verticalGap="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>